# Port for the Express server
PORT=5000

# MongoDB Atlas connection string (Get this from MongoDB Atlas -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/lostandfound?retryWrites=true&w=majority

# Secret key for signing JWT authentication tokens (use a strong random string)
JWT_SECRET=lost_and_found_secure_secret_key_2026
